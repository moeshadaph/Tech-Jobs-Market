{
  "datasets": [
    {
      "name": "cc6be9f7",
      "displayName": "Dataset 1",
      "queryLines": [
        "-- Dataset 1 : compétences les plus demandées\r\n",
        "SELECT skill, nb_offres\r\n",
        "FROM tech_jobs_market.pipeline.top_skills\r\n",
        "ORDER BY nb_offres DESC\r\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "7cfc3f30",
      "displayName": "Dataset 2",
      "queryLines": [
        "-- Dataset 2 : salaires par niveau d'expérience\r\n",
        "SELECT experience_level, salaire_min_moyen, salaire_max_moyen, nb_offres\r\n",
        "FROM tech_jobs_market.pipeline.salary_by_level\r\n",
        "ORDER BY salaire_min_moyen ASC"
      ]
    },
    {
      "name": "30198d1f",
      "displayName": "Dataset 3",
      "queryLines": [
        "-- Dataset 3 : répartition géographique\r\n",
        "SELECT city, remote, nb_offres\r\n",
        "FROM tech_jobs_market.pipeline.jobs_by_city\r\n",
        "ORDER BY nb_offres DESC"
      ]
    }
  ],
